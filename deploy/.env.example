# Copy to deploy/.env, fill it in, then `chmod 600 .env`. docs/ENV.md documents every variable.
SITE_DOMAIN=tautan.id
API_DOMAIN=api.tautan.id

# GHCR image tags: latest, or sha-xxxxxxx to pin (recommended; each repo has its own sha).
TAUTAN_FE_TAG=latest
TAUTAN_BE_TAG=latest

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
# Shared by the FE and the API through this file.
REVALIDATE_SECRET=

# Uploads: local (Docker volume `uploads`) or s3 (Cloudflare R2 recommended: free egress).
STORAGE=local
S3_BUCKET=
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional integrations
INSTAGRAM_OEMBED_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
